{
  "title": "Banking Microservices",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "API Request Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\".*api-service.*\"}[5m])) by (method, route, status)",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API p95 Latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\".*api-service.*\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Messages Processed",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(kafka_messages_processed_total[5m])) by (topic, status)",
          "legendFormat": "{{topic}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Consumer Errors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(kafka_consumer_errors_total[5m])) by (topic, error_type)",
          "legendFormat": "{{topic}} {{error_type}}"
        }
      ]
    }
  ]
}
